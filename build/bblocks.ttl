<bblocks://ogc.overturemaps.schemas.places.place> a skos:Concept,
        dcat:Dataset,
        bblocks:Schema ;
    rdfs:label "Place schema" ;
    dct:abstract "A Place is a point representation of a real-world facility, service, or amenity. Place features are compatible with GeoJSON Point features."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
