<bblocks://ogc.overturemaps.schemas.buildings.building_part> a skos:Concept,
        dcat:Dataset,
        bblocks:Schema ;
    rdfs:label "Building Part schema" ;
    dct:abstract "A single building part. Parts describe their shape and color and other properties. Each building part must contain the building with which it is associated."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
