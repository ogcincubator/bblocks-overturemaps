        dcat:Dataset,
        bblocks:Schema ;
    rdfs:label "Transportation Segment schema" ;
    dct:abstract "Segments are paths which can be traveled by people or things. Segments are compatible with GeoJSON LineString features."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2025-11-05T14:07:00+01:00"^^xsd:dateTime ;
