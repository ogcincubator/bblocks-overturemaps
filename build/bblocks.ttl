<bblocks://ogc.overturemaps.schemas.divisions.division_area> a skos:Concept,
        dcat:Dataset,
        bblocks:Schema ;
    rdfs:label "Division Area schema" ;
    dct:abstract """Division areas are polygons that represent the land or maritime area covered by a division.
Each division area belongs to a division which it references by ID, and for which the division area provides an area polygon. For ease of use, every division area repeats the subtype, names, country, and region properties of the division it belongs to."""^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2025-11-05T14:07:00+01:00"^^xsd:dateTime ;
    dct:description [ dct:format "application/json" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-overturemaps/build/generateddocs/json-full/overturemaps/schemas/divisions/division_area/index.json> ],
