<bblocks://ogc.overturemaps.schemas.divisions.division> a skos:Concept,
        dcat:Dataset,
        bblocks:Schema ;
    rdfs:label "Division schema" ;
    dct:abstract "Divisions are recognized official or non-official organizations of people as seen from a given political perspective. Examples include countries, provinces, cities, towns, neighborhoods, etc."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
