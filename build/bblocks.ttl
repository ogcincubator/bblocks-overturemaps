<bblocks://ogc.overturemaps.schemas.divisions.division_boundary> a skos:Concept,
        dcat:Dataset,
        bblocks:Schema ;
    rdfs:label "Boundary schema" ;
    dct:abstract "Boundaries represent borders between divisions of the same subtype. Some boundaries may be disputed by the divisions on one or both sides."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2025-11-05T14:07:00+01:00"^^xsd:dateTime ;
