        bblocks:Schema ;
    rdfs:label "Building schema" ;
    dct:abstract "A building is a man-made structure with a roof that exists permanently in one place. Buildings are compatible with GeoJSON Polygon features."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
