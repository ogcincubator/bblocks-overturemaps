<bblocks://ogc.overturemaps.schemas.addresses.address> a skos:Concept,
        dcat:Dataset,
        bblocks:Schema ;
    rdfs:label "Address schema" ;
    dct:abstract """Addresses are geographic points used for locating businesses and individuals. The rules, fields, and fieldnames of an address can vary extensively between locations. We use a simplified schema to capture worldwide address points. This initial schema is largely based on the OpenAddresses (www.openaddresses.io) project.
The address schema allows up to 5 "admin levels". Rather than have field names that apply across all countries, we provide an array called "address_levels" containing the necessary administrative levels for an address."""^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2025-11-05T14:07:00+01:00"^^xsd:dateTime ;
    dct:description [ dct:format "text/html" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-overturemaps/bblock/ogc.overturemaps.schemas.addresses.address> ],
        [ dct:format "text/markdown" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-overturemaps/build/generateddocs/markdown/overturemaps/schemas/addresses/address/index.md> ],
        [ dct:format "application/json" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-overturemaps/build/generateddocs/json-full/overturemaps/schemas/addresses/address/index.json> ] ;
    dct:hasVersion "0.1" ;
    dct:modified "2025-12-07"^^xsd:date ;
    skos:inScheme <https://ogcincubator.github.io/bblocks-overturemaps/> ;
    skos:prefLabel "Address schema" ;
    skos:topConceptOf <https://ogcincubator.github.io/bblocks-overturemaps/> ;
    dcat:keyword "addresses",
        "gers",
        "overture-maps",
        "schemas" ;
    prof:hasResource [ dct:conformsTo <https://json-schema.org/draft/2020-12/schema> ;
            dct:format "application/json" ;
            prof:hasArtifact <https://ogcincubator.github.io/bblocks-overturemaps/build/annotated/overturemaps/schemas/addresses/address/schema.json> ;
            prof:hasRole role:schema ],
        [ dct:conformsTo <https://www.w3.org/TR/json-ld11/> ;
            dct:format "application/ld+json" ;
            prof:hasArtifact <https://ogcincubator.github.io/bblocks-overturemaps/build/annotated/overturemaps/schemas/addresses/address/context.jsonld> ;
            prof:hasRole role:mapping ],
        [ dct:conformsTo <https://json-schema.org/draft/2020-12/schema> ;
            dct:format "application/yaml" ;
            prof:hasArtifact <https://ogcincubator.github.io/bblocks-overturemaps/build/annotated/overturemaps/schemas/addresses/address/schema.yaml> ;
            prof:hasRole role:schema ] ;
    bblocks:dependsOn <bblocks://ogc.overturemaps.schemas.definitions> ;
    bblocks:status <http://www.opengis.net/def/status/under-development> ;
    bblocks:validationPassed false .

