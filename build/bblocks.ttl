<bblocks://ogc.overturemaps.schemas.transportation.connector> a skos:Concept,
        dcat:Dataset,
        bblocks:Schema ;
    rdfs:label "Transportation Connector schema" ;
    dct:abstract "Connectors create physical connections between segments. Connectors are compatible with GeoJSON Point features."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
